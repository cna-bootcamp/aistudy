# Python 가상환경 / 캐시
indexing/venv/
retrieve/venv/
**/__pycache__/
*.pyc

# 인덱싱 로그·검증 리포트 (런타임 생성물)
indexing/logs/*.log
indexing/check/*.txt
retrieve/logs/*.log

# 로컬 오버라이드 환경변수 (커밋 금지)
indexing/.env
retrieve/.env

# Neo4j 볼륨 데이터 (런타임 생성·대용량) — 디렉토리 구조는 .gitkeep으로 유지
store/neo4j/data/*
!store/neo4j/data/.gitkeep
store/neo4j/logs/*
!store/neo4j/logs/.gitkeep
store/neo4j/plugins/*
!store/neo4j/plugins/.gitkeep
