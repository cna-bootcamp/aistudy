# indexing/.env (선택) — 로컬 오버라이드용
#
# GROQ_API_KEY 는 hands-on/.env 에서 자동 로드되므로 여기 다시 넣을 필요 없음.
# Neo4j 접속정보나 임베딩 모델을 기본값과 다르게 쓸 때만 아래 값을 복사해 사용.
#
# 우선순위: indexing/.env (override) > hands-on/.env > settings.py 기본값

# --- Neo4j (docker-compose.yml 기본값과 일치) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# --- Ollama 임베딩 ---
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=qwen3-embedding

# --- Groq LPU LLM ---
# GROQ_API_KEY=gsk_...              # 미설정 시 hands-on/.env 값 사용
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b
