# indexing/.env (선택) — 로컬 오버라이드용
#
# GROQ_API_KEY·OPENAI_API_KEY 는 hands-on/.env 에서 자동 로드되므로 여기 다시 넣을 필요 없음.
# Neo4j 접속정보나 임베딩 모델을 기본값과 다르게 쓸 때만 아래 값을 복사해 사용.
#
# 우선순위: indexing/.env (override) > hands-on/.env > settings.py 기본값

# --- Neo4j (docker-compose.yml 기본값과 일치 — 14.graphrag/neo4j 예제와 포트 분리) ---
# NEO4J_URI=bolt://localhost:7688
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# --- OpenAI 임베딩 (agentic-rag 챗봇과 동일 모델·차원 필수) ---
# EMBEDDING_MODEL=text-embedding-3-small

# --- Groq LPU LLM (엔티티/관계 추출) ---
# GROQ_API_KEY=gsk_...              # 미설정 시 hands-on/.env 값 사용
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
