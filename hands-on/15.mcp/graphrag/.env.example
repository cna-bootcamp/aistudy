# GraphRAG MCP 서버 전용 환경변수 오버라이드 예시
# 이 파일을 .env로 복사한 뒤 필요한 값만 수정함.
# GROQ_API_KEY는 hands-on/.env에서 자동 로드되므로 여기서 다시 적을 필요 없음.

# Neo4j 연결 (docker-compose.yml 기본값과 일치)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# Ollama 임베딩 (저장된 벡터가 qwen3-embedding 4096차원이므로 변경 금지 권장)
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=qwen3-embedding

# Groq LPU LLM
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TIMEOUT=60
# GROQ_MAX_RETRIES=1
# GROQ_MAX_TOKENS=2048

# MCP 서버 바인딩 (Streamable HTTP)
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
