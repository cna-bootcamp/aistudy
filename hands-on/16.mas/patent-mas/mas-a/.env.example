# patent-mas / mas-a 환경변수 예시 (선택)
# API 키는 공용 hands-on/.env 에서 로드됨. 이 파일은 서버/검색 파라미터를 덮어쓸 때만 사용.
# 사용 시: 이 파일을 hands-on/.env 에 병합하거나 셸 환경변수로 export 함.

# 필수 (hands-on/.env 에 이미 있어야 함)
# GROQ_API_KEY=gsk_...           # LLM(Groq LPU openai/gpt-oss-120b)
# OPENAI_API_KEY=sk-...          # 임베딩(text-embedding-3-small)

# MCP 서버 바인딩 (기본 127.0.0.1:8010)
# MCP_HOST=127.0.0.1
# MCP_PORT=8010

# 검색 파라미터 오버라이드 (선택)
# MAS_LLM_MODEL=openai/gpt-oss-120b
# MAS_EMBEDDING_MODEL=text-embedding-3-small
# MAS_VECTOR_TOP_K=5
# MAS_COMMUNITY_LEVEL=2
# MAS_SUPERVISOR_MAX_REROUTES=1
