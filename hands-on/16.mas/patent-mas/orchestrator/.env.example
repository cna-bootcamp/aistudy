# patent-mas / orchestrator — environment variables (loaded from shared hands-on/.env)
# The orchestrator reads keys from hands-on/.env (shared by all unit MAS). It does not need
# its own .env file; this sample documents which keys must exist in hands-on/.env.

# --- Required by the orchestrator itself (Scheduler routing, Supervisor validation, synthesis) ---
GROQ_API_KEY=gsk_...          # Groq LPU (openai/gpt-oss-120b)

# --- Required by the unit MAS, consumed inside their own venv workers / MCP server ---
OPENAI_API_KEY=sk-...         # MAS A / MAS B embeddings (text-embedding-3-small)
LAW_OC=your_law_oc            # MAS B / MAS C — korean-law MCP auth (law.go.kr Open API key)
YOUTUBE_API_KEY=AIza...       # MAS B — YouTube Data API v3 (video search)

# --- Optional overrides (MAS A MCP server bind address; defaults 127.0.0.1:8010) ---
# MCP_HOST=127.0.0.1
# MCP_PORT=8010
# ORCH_LLM_MODEL=openai/gpt-oss-120b

# --- Demo/verification toggle (default off) ---
# Force MAS C to escalate so the GLOBAL HITL review panel always appears (for demoing the
# approve/reject flow; real opinions usually pass the gate and skip HITL). Set to 1 to enable.
# ORCH_FORCE_ESCALATE=1
